# Copia este fichero a .env y rellena los valores reales.
# .env NUNCA debe subirse al repositorio (ver .gitignore).

ENVIRONMENT=local

# --- Base de datos ---
# Host = "localhost" si corres uvicorn directamente en tu máquina.
# Host = "mysql" (nombre del servicio) si backend corre dentro de docker-compose.
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=tvtime_clone
MYSQL_USER=tvtime
MYSQL_PASSWORD=tvtime
DATABASE_URL=mysql+aiomysql://tvtime:tvtime@localhost:3306/tvtime_clone

# --- JWT (autenticación local) ---
JWT_SECRET_KEY=changeme-generate-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- TMDB ---
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3

# --- Trakt (OAuth2) ---
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
TRAKT_REDIRECT_URI=http://localhost:8000/api/v1/auth/trakt/callback
TRAKT_BASE_URL=https://api.trakt.tv

# --- Cifrado de tokens Trakt en reposo (cryptography.Fernet) ---
# Obligatorio: el backend no arranca sin esta variable. Generar con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- CORS ---
# Lista separada por comas de orígenes permitidos (frontend Flutter web / dev server)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000
